SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Optional, backend only: enables signup without email verification.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"
MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_VAPID_KEY="your-web-push-vapid-public-key"
# Play Store or direct APK link shown in the Android download popup on mobile browsers.
VITE_ANDROID_APP_URL=""
FCM_SERVER_KEY="your-firebase-server-key"

# Twilio Verify phone OTP.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="your-twilio-verify-service-sid"
# Local dev only: skip Twilio Verify and accept TWILIO_DEV_BYPASS_CODE.
TWILIO_DEV_BYPASS="false"
TWILIO_DEV_BYPASS_CODE="123456"
PHONE_VERIFICATION_SECRET="your-random-phone-verification-secret"
# Set to false to auto-confirm emails via admin API (dev/demo only)
AUTH_REQUIRE_EMAIL_VERIFICATION="true"

# Gmail SMTP for password reset email OTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="your-gmail-address@gmail.com"
EMAIL_OTP_SECRET="your-random-email-otp-secret"
# Local dev only: log/send fixed EMAIL_OTP_DEV_BYPASS_CODE instead of SMTP.
EMAIL_OTP_DEV_BYPASS="false"
EMAIL_OTP_DEV_BYPASS_CODE="123456"

BACKEND_PORT="4000"
BACKEND_HOST="127.0.0.1"
FRONTEND_DEV_URL="http://127.0.0.1:3000"

# Optional production hardening knobs
LOG_LEVEL="info"
RATE_LIMIT_ENABLED="true"
CORS_ALLOW_ALL="false"
# Comma-separated list of allowed origins (used when CORS_ALLOW_ALL=false)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
COOKIE_SECURE="true"

# Optional: only needed for Supabase CLI migrations.
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"
