SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Optional, backend only: enables signup without email verification.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"
MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"
BACKEND_PORT="4000"
BACKEND_HOST="127.0.0.1"
FRONTEND_DEV_URL="http://127.0.0.1:3000"

# Optional production hardening knobs
LOG_LEVEL="info"
RATE_LIMIT_ENABLED="true"
CORS_ALLOW_ALL="false"
# Comma-separated list of allowed origins (used when CORS_ALLOW_ALL=false)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
COOKIE_SECURE="true"

# Optional: only needed for Supabase CLI migrations.
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"
