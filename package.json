{
  "name": "rweezy-fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "node --experimental-strip-types --test tests/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "npm run build && npm run seed:demo && npm run test:e2e",
    "format": "npm --prefix frontend run format",
    "seed:demo": "node scripts/seed-demo-users.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.4.1",
    "supabase": "^2.98.2"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "version": "1.0.0",
  "description": "Rweezy is a full-stack delivery marketplace for food delivery, grocery delivery, ride booking, and package transfer. The project includes role-based experiences for customers, riders, delivery partners, restaurant managers, grocery store managers, and admins.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RihanMujawar/rweezy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RihanMujawar/rweezy/issues"
  },
  "homepage": "https://github.com/RihanMujawar/rweezy#readme",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.0.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  }
}
