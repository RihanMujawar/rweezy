DATABASE_URL="postgresql://user:password@localhost:5432/rweezy"
JWT_SECRET="your-random-jwt-secret"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="4000"
FRONTEND_DEV_URL="http://127.0.0.1:3000"
COOKIE_SECURE="false"
MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"

# WhatsApp OTP via Baileys (direct WhatsApp WebSocket, no gateway needed).
BAILEYS_AUTH_DIR="./baileys_auth_info"
# Phone number for WhatsApp link-code pairing (instead of QR code). Include country code, no + sign.
BAILEYS_PHONE=""
WHATSAPP_OTP_SECRET="your-random-whatsapp-otp-secret"
# Local dev only: skip sending WhatsApp message and accept WHATSAPP_OTP_DEV_BYPASS_CODE.
WHATSAPP_OTP_DEV_BYPASS="false"
WHATSAPP_OTP_DEV_BYPASS_CODE="123456"
PHONE_VERIFICATION_SECRET="your-random-phone-verification-secret"

# Gmail SMTP for password reset email OTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="your-gmail-address@gmail.com"
EMAIL_OTP_SECRET="your-random-email-otp-secret"
# Local dev only: log/send fixed EMAIL_OTP_DEV_BYPASS_CODE instead of SMTP.
EMAIL_OTP_DEV_BYPASS="false"
EMAIL_OTP_DEV_BYPASS_CODE="123456"
